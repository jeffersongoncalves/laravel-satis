parameters:
	ignoreErrors:
		-
			message: '#^Match arm comparison between JeffersonGoncalves\\LaravelSatis\\Enums\\PackageType\:\:Github and JeffersonGoncalves\\LaravelSatis\\Enums\\PackageType\:\:Github is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: src/Actions/ValidatePackageCredentials.php

		-
			message: '#^Unsafe call to private method JeffersonGoncalves\\LaravelSatis\\Models\\Packagist\:\:getRepoByPackagist\(\) through static\:\:\.$#'
			identifier: staticClassAccess.privateMethod
			count: 1
			path: src/Models/Packagist.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: src/Support/SatisConfig.php
