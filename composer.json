{
    "name": "jeffersongoncalves/laravel-satis",
    "description": "A Laravel package for managing private Composer repositories with Satis",
    "keywords": [
        "satis",
        "composer",
        "repository",
        "laravel",
        "private-packages"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-satis",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Sim\u00e3o Gon\u00e7alves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "composer/satis": "3.x-dev",
        "spatie/laravel-package-tools": "^1.15"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.0|^8.0",
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\LaravelSatis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\LaravelSatis\\Tests\\": "tests/",
            "JeffersonGoncalves\\LaravelSatis\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\LaravelSatis\\LaravelSatisServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/satis": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
